# Firebase Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Backend API Configuration
API_BASE_URL=https://alexandria-api-ywcw.onrender.com

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. Firebase API keys for mobile apps are considered public but should still be protected
# 4. Enable Firebase App Check for production to prevent API abuse
